APIFY_TOKEN=
DEEPSEEK_API_KEY=
# DATABASE_URL=sqlite+aiosqlite:///casa_certa.db
# ANALYSIS_MODEL=deepseek-chat   # deepseek-reasoner is deferred
# PRICE_SOURCES=thelastscraper   # exactly one source for now: thelastscraper, tri_angle
# REVIEW_SOURCES=kaix,steadyscrape,tri_angle
# SITE_PASSPHRASE=   # required by `make site`; generate one with `make passphrase`
# SEARCH_SOURCES=tri_angle   # comma-separated, tried in order
# SCREEN_MODEL=deepseek-chat
# DeepSeek prices in USD per million tokens (cache-miss input / output), looked up 2026-11-01 at
# https://api-docs.deepseek.com/quick_start/pricing. That page lists deepseek-flash only (peak rates below, off-peak
# is half); it does not mention the deepseek-chat name, so check it if the estimates matter.
# DEEPSEEK_INPUT_USD_PER_MTOK=0.30
# DEEPSEEK_OUTPUT_USD_PER_MTOK=1.20
